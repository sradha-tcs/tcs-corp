{
  "repoNames": [
    "<assets author host>",
    "<assets delivery host>"
  ],
  "aemTierType": [
    "delivery"
  ],
  "alwaysUseDMDelivery": true,
  "expiryOptions": {
    "allowSelectionAndDrag": false
  },
  "rootPath": "/content/dam/tcs-corp",
  "filterSchema": [
    {
      "groupKey": "FileTypeGroup",
      "header": "File Type",
      "fields": [
        {
          "element": "checkbox",
          "name": "type",
          "defaultValue": ["image/*"],
          "options": [
            { "label": "Image", "value": "image/*", "readOnly": true }
          ]
        }
      ]
    }
  ],
  "vanityPath": "adobe",
  "assetDomainMapping": {
    "<assets delivery host>": "<custom delivery domain>"
  }
}
