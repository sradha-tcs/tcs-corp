# Values of docs/setup/byog/site-config.mjs. Copy to docs/setup/byog/byog.env (not in git) and
# fill in. Program and repository ids, emails and the author host stay out of the repository
# (AGENTS.md); tokens and secrets go in the environment of the shell only, never in a file.

# the Edge Delivery site (Configuration Service): admin.hlx.page/config/{AEM_ORG}/sites/{AEM_SITE}
AEM_ORG=ultimatix
AEM_SITE=tcs-corp

# code source: byog (Cloud Manager, external git) or github (github.com with AEM Code Sync)
CODE_MODE=byog
# CODE_MODE=byog: Cloud Manager > Repositories > the repository > Configure Webhook
CM_PROGRAM_ID=<program id>
CM_REPOSITORY_ID=<repository id>
# CODE_MODE=github
GITHUB_OWNER=Ultimatix
GITHUB_REPO=tcs-corp

# the AEM author host (author-p<program>-e<environment>.adobeaemcloud.com); default: fstab.yaml
# AEM_AUTHOR_HOST=

# access: admins (comma separated), the AEM author's technical account
# (AEM > Tools > Cloud Services > Edge Delivery Services Configuration > Authentication)
ADMIN_EMAILS=<name>@<domain>
TECH_ACCOUNT=<id>@techacct.adobe.com
# optional: AUTHOR_EMAILS, PUBLISH_EMAILS
# optional: PROD_HOST=www.tcs.com (the sitemap origin once the production CDN is set up)
# optional: SIDEKICK_PROJECT=TCS Corporate
# optional: CONFIG_PAGE=/content/tcs-corp/configuration (none: no configuration page mapping)
# optional: BYOG_SECRET=none for a repoless copy of the site (no cm-byog secret, no secretId)

# in the shell only (never in this file):
#   export ADMIN_TOKEN=...      x-auth-token of a site admin (https://admin.hlx.page/login)
#   export CM_BYOG_SECRET=...   the secret Cloud Manager shows once when BYOG is selected
