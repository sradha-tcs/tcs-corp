              "name": "Manual",
              "value": "manual"
            },
            {
              "name": "Auto",
              "value": "auto"
            },
            {
              "name": "Manual and Auto",
              "value": "manual-auto"
            }
          ]
        },
        {
          "component": "number",
          "valueType": "number",
          "name": "carouselInterval",
          "label": "Autoplay interval (seconds)",
          "description": "Time each slide is shown before the next one appears.",
