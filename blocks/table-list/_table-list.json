          "value": 4,
          "validation": {
            "numberMin": 1,
            "numberMax": 10,
            "customErrorMsg": "Maximum items must be between 1 and 10."
          }
        },
        {
          "component": "tab",
          "name": "ctaTab",
          "label": "Call to action"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "viewAllLabel",
          "label": "Text",
          "description": "Text of the link next to the heading, e.g. Industries or All Products & Platforms.",
          "value": ""
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "viewAllLink",
          "label": "Link",
          "description": "Destination of the link next to the heading. The link is shown only when set."
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "ctaStyle",
          "label": "Style",
          "description": "Variation default: filled button (Variation 1), outline button (Variation 2), text link (Variation 3).",
          "value": "",
          "options": [
            {
              "name": "Variation default",
              "value": ""
            },
            {
              "name": "Filled button",
              "value": "primary"
            },
            {
              "name": "Outline button",
              "value": "secondary"
            },
            {
              "name": "Text link",
              "value": "tertiary"
            }
          ]
        },
        {
          "component": "tab",
          "name": "itemsTab",
          "label": "Items"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "numbers",
          "label": "Numbers",
          "description": "Variation default: on mobile only (Variation 1), hidden (Variation 2), shown (Variation 3). Items are numbered 01, 02, ... unless an item has its own Number.",
          "value": "",
          "options": [
            {
              "name": "Variation default",
              "value": ""
            },
            {
              "name": "Show",
              "value": "show"
            },
            {
              "name": "Show on mobile only",
              "value": "mobile"
            },
            {
              "name": "Hide",
              "value": "hide"
            }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "itemAction",
          "label": "Item link",
          "description": "Variation default: arrow (Variation 1), button (Variation 2), diagonal arrow (Variation 3).",
          "value": "",
          "options": [
            {
              "name": "Variation default",
              "value": ""
            },
            {
              "name": "Arrow",
              "value": "arrow"
            },
            {
              "name": "Diagonal arrow",
              "value": "arrow-up-right"
            },
            {
              "name": "Button",
              "value": "button"
            }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "itemButtonLabel",
          "label": "Button text",
          "description": "Text of the item buttons; an item can have its own.",
          "value": "Explore",
          "condition": {
            "or": [
              {
                "===": [
                  {
                    "var": "itemAction"
                  },
                  "button"
                ]
              },
              {
                "and": [
                  {
                    "!": {
                      "var": "itemAction"
                    }
                  },
                  {
                    "===": [
                      {
                        "var": "variations"
                      },
                      "solutions"
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "motion",
          "label": "Motion Type",
          "description": "Animates the items as they scroll into view (not when reduced motion is preferred).",
          "value": "none",
          "options": [
            {
              "name": "None",
              "value": "none"
            },
            {
              "name": "Fade",
              "value": "fade"
            },
            {
              "name": "Slide",
              "value": "slide"
            },
            {
              "name": "Reveal",
              "value": "reveal"
            }
          ]
        }
      ]
    },
    {
