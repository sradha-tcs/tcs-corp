        {
          "component": "select",
          "valueType": "string",
          "name": "variations",
          "label": "Variation",
          "description": "Variation 1: title, description and arrow. Variation 2: description, large title and button. Variation 3: description, number, large title and arrow.",
          "value": "industries",
          "options": [
            {
              "name": "Variation 1 - Title, description, arrow",
              "value": "industries"
            },
            {
              "name": "Variation 2 - Description, large title, button",
              "value": "solutions"
            },
            {
              "name": "Variation 3 - Description, number, large title, arrow",
              "value": "products"
            }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "listHeading",
          "label": "Heading",
          "value": ""
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "listHeadingType",
          "label": "Heading Type",
          "value": "h2",
          "options": [
            {
              "name": "H2",
              "value": "h2"
            },
            {
              "name": "H3",
              "value": "h3"
            },
            {
              "name": "H4",
              "value": "h4"
            }
          ]
        },
        {
