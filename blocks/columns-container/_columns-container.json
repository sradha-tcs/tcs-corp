{
  "definitions": [
    {
      "title": "Columns Container",
      "id": "columns-container",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/section/v1/section",
            "template": {
              "name": "Columns Container",
              "model": "columns-container",
              "filter": "columns-container",
              "style": "columns-container-section",
              "columnsLayout": "equal",
              "columnsGap": "medium",
              "columnsAlign": "top",
              "columnsFrom": "desktop",
              "columnsPerRow": "auto"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "columns-container",
      "fields": [
        {
          "component": "tab",
          "name": "propertiesTab",
          "label": "Content"
        },
        {
          "component": "multiselect",
          "name": "style",
          "label": "Style",
          "value": [
            "columns-container-section"
          ],
          "options": [
            {
              "name": "Columns Container",
              "value": "columns-container-section"
            },
            {
              "name": "Highlight",
              "value": "highlight"
            }
          ],
          "description": "Keep Columns Container selected: it makes the section a Columns Container. Add Highlight for the highlight background, as on sections."
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "sectionWidth",
          "label": "Width Type",
          "value": "full-width",
          "options": [
            {
              "name": "Full Width",
              "value": "full-width"
            },
            {
              "name": "Fixed Width",
              "value": "fixed-width"
            }
          ]
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "backgroundImage",
          "label": "Background Image",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "backgroundImageAlt",
          "label": "Image alt text",
          "description": "Describe the image for screen readers. Leave empty if the image is decorative."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "anchorName",
          "label": "Anchor name",
          "description": "Lets Anchor List links and #links jump to this section, e.g. our-offices (lowercase, no spaces)."
        },
        {
          "component": "tab",
          "name": "layoutTab",
          "label": "Layout"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "columnsPerRow",
          "label": "Columns per row",
          "value": "auto",
          "description": "How many columns sit side by side in a row; more Columns start a new row (e.g. 6 Columns at 3 per row: 2 rows of 3). Automatic: as many as there are Columns, at most 4.",
          "options": [
            {
              "name": "Automatic",
              "value": "auto"
            },
            {
              "name": "1",
              "value": "1"
            },
            {
              "name": "2",
              "value": "2"
            },
            {
              "name": "3",
              "value": "3"
            },
            {
              "name": "4",
              "value": "4"
            }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "columnsLayout",
          "label": "Column widths",
          "value": "equal",
          "options": [
            {
              "name": "Equal",
              "value": "equal"
            },
            {
              "name": "One third, two thirds",
              "value": "1-2"
            },
            {
              "name": "Two thirds, one third",
              "value": "2-1"
            },
            {
              "name": "One quarter, three quarters",
              "value": "1-3"
            },
            {
              "name": "Three quarters, one quarter",
              "value": "3-1"
            }
          ],
          "description": "How wide the columns are side by side. The unequal widths apply to rows of two columns; three or four per row are always equal. Add a Column, then the components of the column after it."
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "columnsGap",
          "label": "Gap",
          "value": "medium",
          "options": [
            {
              "name": "Small",
              "value": "small"
            },
            {
              "name": "Medium",
              "value": "medium"
            },
            {
              "name": "Large",
              "value": "large"
            }
          ],
          "description": "The space between the columns (and between them when stacked)."
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "columnsAlign",
          "label": "Vertical alignment",
          "value": "top",
          "options": [
            {
              "name": "Top",
              "value": "top"
            },
            {
              "name": "Middle",
              "value": "middle"
            },
            {
              "name": "Bottom",
              "value": "bottom"
            },
            {
              "name": "Stretch (equal heights)",
              "value": "stretch"
            }
          ],
          "description": "How columns of different heights line up side by side."
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "columnsFrom",
          "label": "Side by side from",
          "value": "desktop",
          "options": [
            {
              "name": "Tablet (600px)",
              "value": "tablet"
            },
            {
              "name": "Desktop (900px)",
              "value": "desktop"
            },
            {
              "name": "Large desktop (1200px)",
              "value": "large"
            }
          ],
          "description": "Below this width the columns are stacked, one under the other."
        },
        {
          "component": "tab",
          "name": "additionalTab",
          "label": "Additional"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "classes_anchor",
          "label": "Anchor ID",
          "description": "A unique ID of the block on the page, starting with anchor-, e.g. anchor-our-services; link to it with #anchor-our-services.",
          "validation": {
            "regExp": "^anchor-[a-z0-9][a-z0-9-]*$",
            "customErrorMsg": "Start with anchor-, then lower-case letters, digits and hyphens."
          }
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "classes_hideblock",
          "label": "Hide block",
          "description": "Hides the whole block on the page until it is turned off (shown faded in the editor).",
          "value": false
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "classes_animation",
          "label": "Animation Type",
          "value": "",
          "description": "How the block's content appears; repeated items (cards, list items, accordion items, columns) appear one after another. None: shown as is. Not played in the editor or when the visitor prefers reduced motion.",
          "options": [
            {
              "name": "None",
              "value": ""
            },
            {
              "name": "Fade in",
              "value": "motion-fade-in"
            },
            {
              "name": "Fade up",
              "value": "motion-fade-up"
            },
            {
              "name": "Fade down",
              "value": "motion-fade-down"
            },
            {
              "name": "Fade left",
              "value": "motion-fade-left"
            },
            {
              "name": "Fade right",
              "value": "motion-fade-right"
            },
            {
              "name": "Slide up",
              "value": "motion-slide-up"
            },
            {
              "name": "Slide down",
              "value": "motion-slide-down"
            },
            {
              "name": "Slide left",
              "value": "motion-slide-left"
            },
            {
              "name": "Slide right",
              "value": "motion-slide-right"
            },
            {
              "name": "Scale in",
              "value": "motion-scale-in"
            }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "classes_animationspeed",
          "label": "Motion Speed",
          "value": "",
          "description": "How fast the animation runs: 0.3, 0.6 or 0.9 seconds.",
          "options": [
            {
              "name": "Medium",
              "value": ""
            },
            {
              "name": "Fast",
              "value": "motion-fast"
            },
            {
              "name": "Slow",
              "value": "motion-slow"
            }
          ],
          "condition": {
            "and": [
              {
                "var": "classes_animation"
              },
              {
                "!==": [
                  {
                    "var": "classes_animation"
                  },
                  ""
                ]
              }
            ]
          }
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "classes_animationtrigger",
          "label": "Animation Trigger",
          "value": "",
          "description": "When the block's animations run. On Scroll: when the block comes into view (at once if it is in view when the page opens). On Page Load: as soon as the block is ready, wherever it is on the page.",
