              "titleType": "h2",
              "imagePosition": "left",
              "showEyebrow": true,
              "showDescription": true,
              "dateFormat": "dd-mm-yyyy",
              "primaryCtaStyle": "primary",
              "secondaryCtaStyle": "secondary"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "teaser",
      "fields": [
        {
          "component": "tab",
