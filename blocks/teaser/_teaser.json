          "label": "Date Format",
          "value": "dd-mm-yyyy",
          "condition": { "===": [{ "var": "showDate" }, true] },
          "options": [
            { "name": "DD-MM-YYYY", "value": "dd-mm-yyyy" },
            { "name": "MM-DD-YYYY", "value": "mm-dd-yyyy" },
            { "name": "MMM d, yyyy", "value": "mmm-d-yyyy" }
          ]
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "displayTags",
          "label": "Display Tags",
          "value": false
