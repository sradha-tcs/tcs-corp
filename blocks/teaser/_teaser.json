        },
        {
          "component": "text",
          "valueType": "string",
          "name": "imageAlt",
          "label": "Image alt text",
          "description": "Leave empty if the image is decorative.",
          "condition": { "!==": [{ "var": "classes" }, "no-image"] }
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "imagePosition",
          "label": "Image position",
          "value": "left",
          "condition": { "!==": [{ "var": "classes" }, "no-image"] },
          "options": [
            { "name": "Left", "value": "left" },
            { "name": "Right", "value": "right" }
          ]
        },
