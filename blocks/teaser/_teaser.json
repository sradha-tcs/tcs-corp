{
  "definitions": [
    {
      "title": "Teaser",
      "id": "teaser",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Teaser",
              "model": "teaser",
              "key-value": true,
              "titleType": "h2",
              "imagePosition": "left",
              "showEyebrow": true,
              "showDescription": true,
              "dateFormat": "dd-mm-yyyy",
              "primaryCtaStyle": "primary",
              "secondaryCtaStyle": "secondary",
              "filter": "teaser"
            }
          }
        }
      }
    },
    {
      "title": "Link",
      "id": "teaser-link",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Link",
              "model": "teaser-link"
            }
          }
        }
      }
    },
    {
      "title": "Stat",
      "id": "teaser-stat",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "Stat",
              "model": "teaser-stat"
            }
          }
        }
      }
    }
  ],
