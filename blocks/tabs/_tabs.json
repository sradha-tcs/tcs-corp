{
  "definitions": [
    {
      "title": "Tabs",
      "id": "tabs",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/section/v1/section",
            "template": {
              "name": "Tabs",
              "model": "tabs",
              "filter": "tabs",
              "style": "tabs-section",
              "tabsStyle": "underline",
              "tabsAlignment": "left",
              "tabsOrientation": "horizontal"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "tabs",
      "fields": [
        {
          "component": "tab",
          "name": "propertiesTab",
          "label": "Properties"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "style",
          "label": "Component",
          "value": "tabs-section",
          "options": [
            {
              "name": "Tabs",
              "value": "tabs-section"
            }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "anchorName",
          "label": "ID",
          "description": "Unique id of the Tabs, e.g. our-services (lowercase, no spaces). Tabs without an ID of their own get ids from it: our-services-item-1, ... Leave empty for a generated id."
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "sectionWidth",
          "label": "Width Type",
          "value": "full-width",
          "options": [
            {
              "name": "Full Width",
              "value": "full-width"
            },
            {
              "name": "Fixed Width",
              "value": "fixed-width"
            }
          ]
        },
        {
          "component": "tab",
          "name": "accessibilityTab",
          "label": "Accessibility"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "tabsAriaLabel",
          "label": "Label",
          "description": "Names the tab list for screen readers (aria-label), e.g. Our services."
        },
        {
          "component": "tab",
          "name": "stylesTab",
          "label": "Styles"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "tabsStyle",
          "label": "Style",
          "value": "underline",
          "options": [
            {
              "name": "Underline",
              "value": "underline"
            },
            {
              "name": "Boxed",
              "value": "boxed"
            },
            {
              "name": "Pills",
              "value": "pills"
            }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "tabsAlignment",
          "label": "Alignment",
          "value": "left",
          "options": [
            {
              "name": "Left",
              "value": "left"
            },
            {
              "name": "Center",
              "value": "center"
            },
            {
              "name": "Full width (stretch)",
              "value": "stretch"
            }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "tabsOrientation",
          "label": "Orientation",
          "description": "Vertical: the tab list is on the left of the content on desktop, above it on mobile.",
          "value": "horizontal",
          "options": [
            {
              "name": "Horizontal",
              "value": "horizontal"
            },
            {
              "name": "Vertical",
              "value": "vertical"
            }
          ]
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "tabs",
      "components": [
        "tab",
        "columns",
        "title",
        "text",
        "image",
        "button"
      ]
    }
  ]
}
