{
  "definitions": [
    {
      "title": "List",
      "id": "list",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "List",
              "model": "list",
              "filter": "list",
              "key-value": true,
              "titleType": "h2",
              "source": "fixed",
              "orderBy": "manual",
              "sortOrder": "ascending",
              "maxItems": 0,
              "displayAsTeaser": true,
              "cardStyle": "image",
              "imageRatio": "16-9",
              "panelHeight": "portrait",
              "linkItems": true,
              "showImage": true,
              "showEyebrow": true,
              "showTags": true,
              "showDescription": true,
              "showDate": true,
              "dateFormat": "dd-mmm-yy",
              "imageLoading": "lazy",
              "desktopMode": "grid",
              "desktopColumns": 4,
              "tabletMode": "grid",
              "tabletColumns": 4,
              "mobileMode": "grid",
              "mobileColumns": 1,
              "scrollSnap": true,
              "emptyBehavior": "message",
              "analyticsEnabled": true
            }
          }
        }
      }
    },
    {
      "title": "List Item",
      "id": "list-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "List Item",
              "model": "list-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "list",
      "fields": [
        {
          "component": "tab",
          "name": "contentTab",
          "label": "Content"
        },
        {
          "...": "../../models/_card-list.json#/fields/header"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "source",
          "label": "List source",
          "value": "fixed",
          "options": [
            {
              "name": "Child pages",
              "value": "parent"
            },
            {
              "name": "Fixed list",
              "value": "fixed"
            },
            {
              "name": "Tagged pages",
              "value": "tags"
            }
          ],
          "required": true,
          "description": "Child pages of a page, a fixed list of pages (Pages; add List Items to change a card or to link outside the site), or pages with tags."
        },
        {
          "component": "container",
          "name": "pageItems",
          "label": "Pages (authored before List Items)",
          "multi": true,
          "description": "Lists made before List Items. Add List Items instead (Add on the List).",
          "condition": {
            "===": [
              {
                "var": "source"
              },
              "fixed"
            ]
          },
          "fields": [
            {
              "component": "aem-content",
              "valueType": "string",
              "name": "page",
              "label": "Page"
            }
          ]
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "parentPath",
          "label": "Parent page",
          "condition": {
            "===": [
              {
                "var": "source"
              },
              "parent"
            ]
          }
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "parentUseCurrentPage",
          "label": "Use the current page when empty",
          "value": true,
          "condition": {
            "===": [
              {
                "var": "source"
              },
              "parent"
            ]
          }
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "directChildrenOnly",
          "label": "Direct children only",
          "value": true,
          "description": "Off: pages down to the Child depth.",
          "condition": {
            "===": [
              {
                "var": "source"
              },
              "parent"
            ]
          }
        },
        {
          "component": "number",
          "valueType": "number",
          "name": "childDepth",
          "label": "Child depth",
          "value": 2,
          "min": 1,
          "max": 10,
          "description": "Levels below the parent page (1: its children).",
          "condition": {
            "and": [
              {
                "===": [
                  {
                    "var": "source"
                  },
                  "parent"
                ]
              },
              {
                "===": [
                  {
                    "var": "directChildrenOnly"
                  },
                  false
                ]
              }
            ]
          }
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "rootPath",
          "label": "Search root",
          "condition": {
            "===": [
              {
                "var": "source"
              },
              "tags"
            ]
          }
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "tagsUseCurrentPage",
          "label": "Use the current page when empty",
          "value": true,
          "condition": {
            "===": [
              {
                "var": "source"
              },
              "tags"
            ]
          }
        },
        {
          "component": "aem-tag",
          "valueType": "string",
          "name": "tags",
          "label": "Tags",
          "multi": true,
          "condition": {
            "===": [
              {
                "var": "source"
              },
              "tags"
            ]
          }
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "tagMatch",
          "label": "Match",
          "value": "any",
          "options": [
            {
              "name": "Any of the tags",
              "value": "any"
            },
            {
              "name": "All of the tags",
              "value": "all"
            }
          ],
          "condition": {
            "===": [
              {
                "var": "source"
              },
              "tags"
            ]
          }
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "includeDescendants",
          "label": "Include descendant pages",
          "value": true,
          "description": "Off: only the children of the search root.",
          "condition": {
            "===": [
              {
                "var": "source"
              },
              "tags"
            ]
          }
        },
        {
          "component": "number",
          "valueType": "number",
          "name": "maxDepth",
          "label": "Maximum search depth",
          "value": 0,
          "min": 0,
          "max": 10,
          "description": "0: no limit.",
          "condition": {
            "and": [
              {
                "===": [
                  {
                    "var": "source"
                  },
                  "tags"
                ]
              },
              {
                "===": [
                  {
                    "var": "includeDescendants"
                  },
                  true
                ]
              }
            ]
          }
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "orderBy",
          "label": "Order by",
          "value": "manual",
          "options": [
            {
              "name": "Manual (as authored; path order for pages)",
              "value": "manual"
            },
            {
              "name": "Title",
              "value": "title"
            },
            {
              "name": "Last modified",
              "value": "lastModified"
            }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "sortOrder",
          "label": "Sort order",
          "value": "ascending",
          "options": [
            {
              "name": "Ascending",
              "value": "ascending"
            },
            {
              "name": "Descending",
              "value": "descending"
            }
          ],
          "condition": {
            "!==": [
              {
                "var": "orderBy"
              },
              "manual"
            ]
          }
        },
        {
          "component": "number",
          "valueType": "number",
          "name": "maxItems",
          "label": "Maximum items",
          "value": 0,
          "min": 0,
          "max": 200,
          "description": "0: all of them."
        },
        {
          "component": "tab",
          "name": "cardsTab",
          "label": "Display"
        },
        {
          "...": "../../models/_card-list.json#/fields/cards"
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "featureShowAuthor",
          "label": "Show author on feature card",
          "value": true,
          "description": "The author of the feature card's page (photo, name and designation from the Authors sheet). Off: the feature card without its author; the other cards don't change.",
          "condition": {
            "and": [
              {
                "===": [
                  {
                    "var": "displayAsTeaser"
                  },
                  true
                ]
              },
              {
                "===": [
                  {
                    "var": "featureFirst"
                  },
                  true
                ]
              }
            ]
          }
        },
        {
          "...": "../../models/_card-list.json#/fields/cardsShow"
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "showContentLabel",
          "label": "Show content type",
          "value": true,
          "description": "Image cards: the content type of the card's page (e.g. Case Study): its content type tag below the image and its content-type label next to the date. Off: image cards without either (the other tags and the date stay); the page metadata and the other card styles don't change.",
          "condition": {
            "and": [
              {
                "===": [
                  {
                    "var": "displayAsTeaser"
                  },
                  true
                ]
              },
              {
                "or": [
                  {
                    "===": [
                      {
                        "var": "cardStyle"
                      },
                      "image"
                    ]
                  },
                  {
                    "===": [
                      {
                        "var": "cardStyle"
                      },
                      "mixed"
                    ]
                  }
                ]
              }
            ]
          }
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "showCta",
          "label": "Show call to action",
          "value": true,
          "description": "Child pages with Card style Panel: the Explore call to action on every card. Not shown for other sources or card styles (their cards keep their call to action; Fixed list: each List Item's Show Action Label).",
          "condition": {
            "and": [
              {
                "===": [
                  {
                    "var": "source"
                  },
                  "parent"
                ]
              },
              {
                "===": [
                  {
                    "var": "displayAsTeaser"
                  },
                  true
                ]
              },
              {
                "===": [
                  {
                    "var": "cardStyle"
                  },
                  "panel"
                ]
              }
            ]
          }
        },
