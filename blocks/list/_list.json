            {
              "name": "Any of the tags",
              "value": "any"
            },
            {
              "name": "All of the tags",
              "value": "all"
            }
          ],
          "condition": {
            "===": [
              {
                "var": "source"
              },
              "tags"
            ]
          }
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "includeDescendants",
          "label": "Include descendant pages",
          "value": true,
