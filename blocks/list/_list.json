{
  "definitions": [
    {
      "title": "List",
      "id": "list",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "List",
              "model": "list",
              "filter": "list",
              "key-value": true,
              "titleType": "h2",
              "source": "fixed",
              "orderBy": "manual",
              "sortOrder": "ascending",
              "maxItems": 0,
              "displayAsTeaser": true,
              "cardStyle": "image",
              "imageRatio": "16-9",
              "panelHeight": "portrait",
              "linkItems": true,
              "showImage": true,
              "showEyebrow": true,
              "showTags": true,
              "showDescription": true,
              "showDate": true,
              "dateFormat": "dd-mmm-yy",
              "showCta": true,
              "imageLoading": "lazy",
              "desktopMode": "grid",
              "desktopColumns": 4,
              "tabletMode": "grid",
              "tabletColumns": 4,
              "mobileMode": "grid",
              "mobileColumns": 1,
              "scrollSnap": true,
              "emptyBehavior": "message",
              "analyticsEnabled": true
            }
          }
        }
      }
    },
    {
      "title": "List Item",
      "id": "list-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "List Item",
              "model": "list-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "list",
      "fields": [
        {
          "component": "tab",
          "name": "contentTab",
          "label": "Content"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "title",
          "label": "Title",
          "description": "The heading of the list, e.g. Related to Agentic AI."
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "titleType",
          "label": "Heading type",
          "value": "h2",
          "options": [
            {
              "name": "H2",
              "value": "h2"
            },
            {
              "name": "H3",
              "value": "h3"
            },
            {
              "name": "H4",
              "value": "h4"
            },
            {
              "name": "H5",
              "value": "h5"
            },
            {
              "name": "H6",
              "value": "h6"
            }
          ]
        },
        {
          "component": "richtext",
          "valueType": "string",
          "name": "description",
          "label": "Description"
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "link",
          "label": "CTA link"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "linkText",
          "label": "CTA text"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "linkType",
          "label": "CTA style",
          "value": "",
          "options": [
            {
              "name": "Text link",
              "value": ""
            },
            {
              "name": "Primary button",
              "value": "primary"
            },
            {
              "name": "Secondary button",
              "value": "secondary"
            }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "listLabel",
          "label": "Accessible list label",
          "description": "Names the list for screen readers when it has no title."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "componentId",
          "label": "Component ID",
          "description": "Unique on the page (letters, digits, - and _); used for deep links and analytics, so changing it changes those. Empty: generated.",
          "validation": {
            "regExp": "^[A-Za-z][A-Za-z0-9_-]*$",
            "customErrorMsg": "Start with a letter; use letters, digits, - and _."
          }
        },
        {
          "component": "tab",
          "name": "sourceTab",
          "label": "Source"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "source",
          "label": "List source",
          "value": "fixed",
          "options": [
            {
              "name": "Child pages",
              "value": "parent"
            },
            {
              "name": "Fixed list",
              "value": "fixed"
            },
            {
              "name": "Tagged pages",
              "value": "tags"
            }
          ],
          "required": true,
          "description": "Child pages of a page, a fixed list of pages and links (add List Items to the block), or pages with tags."
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "parentPath",
          "label": "Parent page",
          "condition": {
            "===": [
              {
                "var": "source"
              },
              "parent"
            ]
          }
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "parentUseCurrentPage",
          "label": "Use the current page when empty",
          "value": true,
          "condition": {
            "===": [
              {
                "var": "source"
              },
              "parent"
            ]
          }
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "directChildrenOnly",
          "label": "Direct children only",
          "value": true,
          "description": "Off: pages down to the Child depth.",
          "condition": {
            "===": [
              {
                "var": "source"
              },
              "parent"
            ]
          }
        },
        {
          "component": "number",
          "valueType": "number",
          "name": "childDepth",
          "label": "Child depth",
          "value": 2,
          "min": 1,
          "max": 10,
          "description": "Levels below the parent page (1: its children).",
          "condition": {
            "and": [
              {
                "===": [
                  {
                    "var": "source"
                  },
                  "parent"
                ]
              },
              {
                "===": [
                  {
                    "var": "directChildrenOnly"
                  },
                  false
                ]
              }
            ]
          }
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "rootPath",
          "label": "Search root",
          "condition": {
            "===": [
              {
                "var": "source"
              },
              "tags"
            ]
          }
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "tagsUseCurrentPage",
          "label": "Use the current page when empty",
          "value": true,
          "condition": {
            "===": [
              {
                "var": "source"
              },
              "tags"
            ]
          }
        },
        {
          "component": "aem-tag",
          "valueType": "string",
          "name": "tags",
          "label": "Tags",
          "multi": true,
          "condition": {
            "===": [
              {
                "var": "source"
              },
              "tags"
            ]
          }
        },
        {
          "component": "select",
          "valueType": "string",
