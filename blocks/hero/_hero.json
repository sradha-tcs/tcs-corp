{
  "definitions": [
    {
      "title": "Hero",
      "id": "hero",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "Hero",
              "model": "hero",
              "classes_alignment": "align-middle",
              "content_titleType": "h1",
              "classes_horizontal": "align-center",
              "classes_textAlignment": "text-center",
              "filter": "hero"
            }
          }
        }
      }
    },
    {
      "title": "CTA",
      "id": "hero-cta",
