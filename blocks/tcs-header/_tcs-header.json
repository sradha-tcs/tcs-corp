{
  "definitions": [
    {
      "title": "TCS Header",
      "id": "tcs-header",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "TCS Header",
              "model": "tcs-header",
              "key-value": true
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "tcs-header",
      "fields": [
        {
          "component": "tab",
          "name": "contentTab",
          "label": "Content"
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "tcsLogo",
          "label": "TCS Logo",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "tcsLogoAlt",
          "label": "TCS Logo Alt Text",
          "value": "Tata Consultancy Services",
          "description": "Names the logo link for screen readers."
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "tcsLogoLink",
          "label": "TCS Logo Link",
          "description": "Usually the locale Home page."
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "tataLogo",
          "label": "TATA Logo",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "tataLogoAlt",
          "label": "TATA Logo Alt Text",
          "value": "TATA Group",
          "description": "Names the logo link for screen readers."
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "tataLogoLink",
          "label": "TATA Logo Link",
          "description": "Usually https://www.tata.com/."
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "headerBgStyle",
          "label": "Header Background",
          "description": "Select background type for the header bar.",
          "value": "transparent",
          "options": [
            { "name": "Transparent", "value": "transparent" },
            { "name": "Static White", "value": "static" }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "headerPositionStyle",
          "label": "Header Position",
          "description": "Sticky keeps header pinned on scroll; Float flows naturally in layout.",
          "value": "sticky",
          "options": [
            { "name": "Sticky / Fixed", "value": "sticky" },
            { "name": "Float / Relative", "value": "float" }
          ]
        },
        {
          "component": "container",
          "name": "menu",
          "label": "Menu",
          "collapsible": true,
          "fields": [
            {
              "component": "aem-content",
              "valueType": "string",
              "name": "menuRootPath",
              "label": "Menu root path",
              "description": "Path to populate dynamic menu links if bulleted list is absent on Navigation page."
            },
            {
              "component": "number",
              "valueType": "number",
              "name": "menuDepth",
              "label": "Menu depth",
              "value": 1,
              "min": 1,
              "max": 3,
              "description": "Levels below the menu root path to fetch from query index."
            }
          ]
        },
        {
          "component": "tab",
          "name": "additionalTab",
          "label": "Additional"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "classes_anchor",
          "label": "Anchor ID",
          "description": "A unique ID of the block on the page, starting with anchor-",
          "validation": {
            "regExp": "^anchor-[a-z0-9][a-z0-9-]*$",
            "customErrorMsg": "Start with anchor-, then lower-case letters, digits and hyphens."
          }
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "classes_hideblock",
          "label": "Hide block",
          "value": false
        }
      ]
    }
  ],
  "filters": []
}