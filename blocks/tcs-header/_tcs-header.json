{
  "definitions": [
    {
      "title": "TCS Header",
      "id": "tcs-header",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "TCS Header",
              "model": "tcs-header",
              "key-value": true
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "tcs-header",
      "fields": [
        {
          "component": "tab",
          "name": "contentTab",
          "label": "Content"
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "tcsLogo",
          "label": "TCS Logo",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "tcsLogoAlt",
          "label": "TCS Logo Alt Text",
          "value": "Tata Consultancy Services",
          "description": "Names the logo link for screen readers."
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "tcsLogoLink",
          "label": "TCS Logo Link",
          "description": "Usually the locale Home page."
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "tataLogo",
          "label": "TATA Logo",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "tataLogoAlt",
          "label": "TATA Logo Alt Text",
          "value": "TATA Group",
          "description": "Names the logo link for screen readers."
        },
        {
          "component": "aem-content",
          "valueType": "string",
          "name": "tataLogoLink",
          "label": "TATA Logo Link",
          "description": "Usually https://www.tata.com/."
        },
        {
          "component": "container",
          "name": "menu",
          "label": "Menu",
          "collapsible": true,
          "fields": [
            {
              "component": "aem-content",
              "valueType": "string",
              "name": "menuRootPath",
              "label": "Menu root path",
              "description": "Select the parent folder of the navigation pages (e.g., /curated-design-pages)"
            },
            {
              "component": "number",
              "valueType": "number",
              "name": "menuDepth",
              "label": "Menu depth",
              "value": 3,
              "min": 1,
              "max": 3
            }
          ]
        },
        {
          "component": "tab",
          "name": "displayTab",
          "label": "Display"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "headerOverlay",
          "label": "Header over the first block",
          "value": "",
          "description": "At every width: whether the logo bar lies transparent over the page's first block. Auto: over an opening light Hero.",
          "options": [
            { "name": "Auto (over a light Hero)", "value": "" },
            { "name": "Always (over the first block)", "value": "always" },
            { "name": "Never (the page starts below the header)", "value": "never" }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "headerPosition",
          "label": "Shared header behavior",
          "value": "sticky",
          "description": "Used by devices set to Use shared behavior. Independent of Header over the first block.",
          "options": [
            { "name": "Sticky (stays at the top)", "value": "sticky" },
            { "name": "Float (scrolls with the page)", "value": "float" }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "headerDesktopPosition",
          "label": "Desktop behavior",
          "value": "float",
          "description": "From 1200px. Float scrolls away with the page; Sticky stays at the top.",
          "options": [
            { "name": "Float (scrolls with the page)", "value": "float" },
            { "name": "Sticky (stays at the top)", "value": "sticky" },
            { "name": "Use shared behavior", "value": "shared" }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "headerTabletPosition",
          "label": "Tablet behavior",
          "value": "sticky",
          "description": "From 600px to 1199px. Sticky stays at the top; Float scrolls away with the page.",
          "options": [
            { "name": "Sticky (stays at the top)", "value": "sticky" },
            { "name": "Float (scrolls with the page)", "value": "float" },
            { "name": "Use shared behavior", "value": "shared" }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "headerMobilePosition",
          "label": "Mobile behavior",
          "value": "sticky",
          "description": "Below 600px. Sticky stays at the top; Float scrolls away with the page.",
          "options": [
            { "name": "Sticky (stays at the top)", "value": "sticky" },
            { "name": "Float (scrolls with the page)", "value": "float" },
            { "name": "Use shared behavior", "value": "shared" }
          ]
        },
        {
          "component": "tab",
          "name": "additionalTab",
          "label": "Additional"
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "classes_anchor",
          "label": "Anchor ID",
          "description": "A unique ID of the block on the page, starting with anchor-",
          "validation": {
            "regExp": "^anchor-[a-z0-9][a-z0-9-]*$",
            "customErrorMsg": "Start with anchor-, then lower-case letters, digits and hyphens."
          }
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "classes_hideblock",
          "label": "Hide block",
          "value": false
        }
      ]
    }
  ],
  "filters": []
}