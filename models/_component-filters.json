[
  {
    "id": "main",
    "components": [
      "section",
      "gen-carousel",
      "tabs",
      "columns-container"
    ]
  },
  {
    "...": "./_section.json#/filters"
  },
  {
    "...": "../blocks/*/_*.json#/filters"
  },
  {
    "id": "richtext",
    "components": [
      "richtext"
    ],
    "rte": {
      "toolbar": {
        "format": [
          "bold",
          "italic",
          "underline",
          "strike",
          "code_inline"
        ],
        "indentation": [
          "indent",
          "outdent"
        ],
        "blocks": [
          "paragraph",
          "h1",
          "h2",
          "h3",
          "h4",
          "h5",
          "h6",
          "code_block",
          "blockquote"
        ],
        "list": [
          "bullet_list",
          "ordered_list"
        ],
        "insert": [
          "link",
          "unlink",
          "image",
          "special_characters"
        ],
        "sr_script": [
          "superscript",
          "subscript"
        ],
        "editor": [
          "removeformat",
          "clean_unsupported_tags",
          "paste_text"
        ],
        "sections": [
          "format",
          "blocks",
          "list",
          "indentation",
          "insert",
          "sr_script",
          "editor"
        ]
      },
      "actions": {
        "bold": {
          "tag": "strong"
        },
        "italic": {
          "tag": "em"
        },
        "strike": {
          "tag": "del"
        },
        "image": {
          "wrapInPicture": true
        },
        "indentation": {
          "scope": "lists"
        },
        "link": {
          "hideTarget": true
        }
      }
    }
  }
]
