[
  {
    "id": "main",
    "components": [
      "section",
      "gen-carousel",
      "tabs",
      "columns-container"
    ]
  },
  {
    "id": "richtext",
    "rte": {
      "toolbar": {
        "blocks": ["paragraph", "h1", "h2", "h3", "h4", "h5", "h6", "code_block"],
        "format": ["bold", "italic", "underline", "strike", "code_inline"],
        "sr_script": ["superscript", "subscript"],
        "list": ["bullet_list", "ordered_list"],
        "insert": ["link", "unlink", "image", "special_characters"],
        "editor": ["removeformat", "clean_unsupported_tags", "paste_text", "find_and_replace", "fullscreen"],
        "sections": ["blocks", "format", "sr_script", "list", "insert", "editor"]
      },
      "actions": {
        "bold": { "tag": "strong" },
        "italic": { "tag": "em" },
        "link": { "hideTarget": true },
        "special_characters": {
          "label": "Special characters",
          "characters": [
            { "character": "©", "title": "Copyright" },
            { "character": "®", "title": "Registered trademark" },
            { "character": "™", "title": "Trademark" },
            { "character": "℠", "title": "Service mark" },
            { "character": "€", "title": "Euro" },
            { "character": "£", "title": "Pound" },
            { "character": "¥", "title": "Yen" },
            { "character": "₹", "title": "Indian rupee" },
            { "character": "$", "title": "Dollar" },
            { "character": "¢", "title": "Cent" },
            { "character": "%", "title": "Percent" },
            { "character": "‰", "title": "Per mille" },
            { "character": "°", "title": "Degree" },
            { "character": "±", "title": "Plus or minus" },
            { "character": "×", "title": "Multiplication" },
            { "character": "÷", "title": "Division" },
            { "character": "≈", "title": "Approximately equal" },
            { "character": "≠", "title": "Not equal" },
            { "character": "≤", "title": "Less than or equal" },
            { "character": "≥", "title": "Greater than or equal" },
            { "character": "∞", "title": "Infinity" },
            { "character": "µ", "title": "Micro" },
            { "character": "½", "title": "One half" },
            { "character": "¼", "title": "One quarter" },
            { "character": "¾", "title": "Three quarters" },
            { "character": "–", "title": "En dash" },
            { "character": "—", "title": "Em dash" },
            { "character": "…", "title": "Ellipsis" },
            { "character": "•", "title": "Bullet" },
            { "character": "·", "title": "Middle dot" },
            { "character": "‘", "title": "Left single quotation mark" },
            { "character": "’", "title": "Right single quotation mark" },
            { "character": "“", "title": "Left double quotation mark" },
            { "character": "”", "title": "Right double quotation mark" },
            { "character": "«", "title": "Left angle quotation mark" },
            { "character": "»", "title": "Right angle quotation mark" },
            { "character": "§", "title": "Section" },
            { "character": "¶", "title": "Paragraph sign" },
            { "character": "†", "title": "Dagger" },
            { "character": "‡", "title": "Double dagger" },
            { "character": "→", "title": "Right arrow" },
            { "character": "←", "title": "Left arrow" },
            { "character": "↑", "title": "Up arrow" },
            { "character": "↓", "title": "Down arrow" },
            { "character": "✓", "title": "Check mark" }
          ]
        }
      }
    }
  },
  {
    "...": "./_section.json#/filters"
  },
  {
    "...": "../blocks/*/_*.json#/filters"
  }
]
