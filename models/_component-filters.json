[
  {
    "id": "main",
    "components": [
      "section",
      "gen-carousel",
      "tabs",
      "columns-container"
    ]
  },
  {
    "id": "richtext",
    "rte": {
      "toolbar": {
        "blocks": ["paragraph", "h2", "h3", "h4", "h5", "h6", "code_block"],
        "format": ["bold", "italic", "underline", "strike", "code_inline"],
        "sr_script": ["superscript", "subscript"],
        "list": ["bullet_list", "ordered_list"],
        "insert": ["link", "unlink", "special_characters"],
        "editor": ["removeformat", "clean_unsupported_tags", "paste_text", "find_and_replace", "fullscreen"],
        "sections": ["blocks", "format", "sr_script", "list", "insert", "editor"]
      },
      "actions": {
        "bold": { "tag": "strong" },
        "italic": { "tag": "em" },
        "link": { "hideTarget": true }
      }
    }
  },
  {
    "...": "./_section.json#/filters"
  },
  {
    "...": "../blocks/*/_*.json#/filters"
  }
]
