{
  "description": "Universal Editor rich text editor (RTE) configuration, referenced by the component filters (\"rte\": {\"...\": \"<path>/models/_rte.json#/rte\"}); KB-D-080, KB-D-082. Only tools whose output Edge Delivery publishes: text colour, alignment, direction, paragraph indentation, text style classes and the link target are left out (Edge Delivery drops style, class and dir attributes and spans); the Rich Text block's Style tab has them as block options. rte: blocks and items (rich text fields, the Rich Text block); text: the built-in Text component, without tables (a table in default content becomes a block on Edge Delivery).",
  "rte": {
    "toolbar": {
      "format": [
        "bold",
        "italic",
        "underline",
        "strike",
        "code_inline"
      ],
      "indentation": [
        "indent",
        "outdent"
      ],
      "blocks": [
        "paragraph",
        "h1",
        "h2",
        "h3",
        "h4",
        "h5",
        "h6",
        "code_block",
        "blockquote"
      ],
      "list": [
        "bullet_list",
        "ordered_list"
      ],
      "insert": [
        "link",
        "unlink",
        "image",
        "table",
        "special_characters"
      ],
      "sr_script": [
        "superscript",
        "subscript"
      ],
      "editor": [
        "removeformat",
        "clean_unsupported_tags",
        "paste_text",
        "find_and_replace",
        "fullscreen"
      ]
    },
    "actions": {
      "bold": {
        "tag": "strong"
      },
      "italic": {
        "tag": "em"
      },
      "strike": {
        "tag": "del"
      },
      "underline": {},
      "code_inline": {},
      "bullet_list": {
        "wrapInParagraphs": false
      },
      "ordered_list": {
        "wrapInParagraphs": false
      },
      "indentation": {
        "scope": "lists"
      },
      "image": {
        "wrapInPicture": false
      },
      "link": {
        "hideTarget": true
      },
      "unlink": {},
      "table": {
        "wrapInParagraphs": false,
        "showTableProperties": true,
        "showRowProperties": true,
        "showCellProperties": true
      },
      "blockquote": {
        "label": "Quote"
      },
      "special_characters": {},
      "paste_text": {},
      "find_and_replace": {},
      "fullscreen": {}
    },
    "unsupportedHtml": true
  },
