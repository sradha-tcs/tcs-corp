{
  "definitions": [
    {
      "title": "Section",
      "id": "section",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/section/v1/section",
            "template": {
              "model": "section"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "section",
      "fields": [
        {
          "component": "text",
          "name": "name",
          "label": "Section Name",
          "description": "The label shown for this section in the Content Tree"
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "style",
          "label": "Style",
          "value": "",
          "options": [
            {
              "name": "Default",
              "value": ""
            },
            {
              "name": "Grey",
              "value": "bg-grey"
            },
            {
              "name": "Dark",
              "value": "bg-dark"
            },
            {
              "name": "Dark Green",
              "value": "bg-dark-green"
            }
          ],
          "description": "The background colour of the section, as the Teaser's BG Color: only the colour (the section keeps its own spacing, inside the colour); text, links and buttons turn light on Dark and Dark Green."
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "sectionWidth",
          "label": "Width Type",
          "value": "full-width",
          "options": [
            {
              "name": "Full Width",
              "value": "full-width"
            },
            {
              "name": "Fixed Width",
              "value": "fixed-width"
            }
          ]
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "roundedEdge",
          "label": "Rounded edge"
        },
        {
          "component": "reference",
          "valueType": "string",
          "name": "backgroundImage",
          "label": "Background Image",
          "multi": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "backgroundImageAlt",
          "label": "Image alt text",
          "description": "Describe the image for screen readers. Leave empty if the image is decorative."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "anchorName",
          "label": "Anchor name",
          "description": "Lets Anchor List links jump to this section, e.g. overview (lowercase, no spaces).",
          "validation": {
            "regExp": "^#?[a-z0-9][a-z0-9-]*$",
            "customErrorMsg": "Lower-case letters, digits and hyphens, e.g. our-offices."
          }
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "section",
      "components": [
        "text",
        "image",
        "button-block",
        "title",
        "page-header",
        "hero",
        "teaser",
        "quote",
        "testimonial",
        "anchor-list",
        "accordion",
        "tabs-block",
        "table",
        "table-list",
        "list",
        "separator",
        "embed",
        "video",
        "modal",
        "form-variations",
        "filter-list",
        "conversation-canvas",
        "cards",
        "fragment",
        "footer",
        "tcs-header"
      ]
    }
  ]
}
