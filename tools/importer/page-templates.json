        "https://www.tcs.com/who-we-are/newsroom/press-release/tcs-renews-title-partnership-jaguar-tcs-racing-expands-role-as-official-ai-partner-formula-e-gen4-era",
        "https://www.tcs.com/who-we-are/newsroom/press-release/mystate-limited-selects-tcs-bancs-transform-core-banking-operations",
        "https://www.tcs.com/who-we-are/newsroom/press-release/tcs-certified-top-employe-in-latin-america-"
      ],
      "representativeUrl": "https://www.tcs.com/who-we-are/newsroom/press-release/best-buys-global-capability-center-india-transition-tcs",
      "description": "tcs.com press releases (source template TCS NewsRoom Template): page header from metadata, body as default content (tables as Table blocks, images), the About TCS boilerplate, TCS media contacts (Media Contacts block), In the News (List block)",
      "blocks": [
        {
          "name": "page-header",
          "instances": [
            "div.heroBanner"
          ]
        },
        {
          "name": "table",
          "instances": [
            "div.heroBanner ~ div.rowContainer div.richText table",
            "div.heroBanner ~ div.responsivegrid div.rowContainer table"
          ]
        },
        {
          "name": "media-contacts",
          "instances": [
            "div.cmp-experiencefragment--media-contacts"
          ]
        },
        {
          "name": "list",
          "instances": [
            "div.cmp-experiencefragment--media-contacts div.relatedContent"
          ]
        },
        {
          "name": "teaser",
          "instances": [
            "div.cmp-experiencefragment--email-sign-up"
          ]
        }
      ],
      "urlPattern": "/who-we-are/newsroom/press-release/*",
      "sections": [
        {
          "id": "rc1",
          "name": "page-header",
          "selector": [
            "div.heroBanner"
          ],
          "style": null,
          "blocks": [
            "page-header"
          ],
          "defaultContent": []
        },
        {
          "id": "rc2",
          "name": "press-release-body",
          "selector": [
            "div.heroBanner ~ div.rowContainer div.richText",
            "div.heroBanner ~ div.responsivegrid div.rowContainer div.w-75"
          ],
          "style": null,
          "blocks": [
            "table"
          ],
          "defaultContent": [
            "div.heroBanner ~ div.rowContainer div.richText > :not(div.table__scroller-rte)",
            "div.heroBanner ~ div.responsivegrid div.rowContainer div.w-75 > :not(div.table__scroller-rte)"
          ]
        },
        {
          "id": "rc3",
          "name": "about-tcs",
          "selector": [
            "div.heroBanner ~ div.rowContainer ~ div.rowContainer div.richText"
          ],
          "style": null,
          "blocks": [],
          "defaultContent": [
            "div.heroBanner ~ div.rowContainer ~ div.rowContainer div.richText > *"
          ]
        },
        {
          "id": "rc4",
          "name": "media-contacts",
          "selector": [
            "div.cmp-experiencefragment--media-contacts"
          ],
          "style": null,
          "blocks": [
            "media-contacts"
          ],
          "defaultContent": []
        },
        {
