      {
        "component": "select",
        "name": "linkType",
        "label": "Type",
        "value": "primary",
        "condition": {
          "or": [
            {
              "!": {
                "var": "buttonView"
              }
            },
            {
              "===": [
                {
                  "var": "buttonView"
                },
                "button"
              ]
            },
            {
              "===": [
                {
                  "var": "buttonView"
                },
                "icon"
              ]
            }
          ]
        },
        "options": [
          {
            "name": "Primary",
            "value": "primary"
          },
          {
            "name": "Secondary",
            "value": "secondary"
          },
          {
            "name": "Tertiary",
            "value": "tertiary"
          }
        ]
      },
      {
        "component": "select",
        "name": "buttonIcon",
        "label": "Icon",
        "condition": {
          "===": [
            {
              "var": "buttonView"
            },
            "icon"
          ]
        },
        "options": [
          {
            "name": "Arrow right",
            "value": "arrow-right"
          },
          {
            "name": "Chevron right",
            "value": "chevron-right"
